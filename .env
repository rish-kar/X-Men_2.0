# X-Men Application Configuration
# Server Configuration
SERVER_PORT=8081

# API Configuration
API_BASE_URL=http://localhost:8081
API_GENERATE_MUTATIONS_ENDPOINT=/api/generateMutations
API_FULL_URL=http://localhost:8081/api/generateMutations

# CORS Configuration (explicit list only)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:5173
CORS_MAX_AGE=3600

# Application Settings
APP_NAME=X-Men

# Health Check Configuration
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

