<?xml version="1.0" encoding="UTF-8"?>
<!--
   X-Men Chat Assistant - Training Placeholder

   This file is YOUR training surface. Anything you add here is loaded by the
   AIML 2.0 engine the next time X-Men starts. Nothing in this file is
   "magic" - it's plain AIML.

   To teach the bot a new fact, add a category block like the example near
   the bottom. The PATTERN goes in UPPERCASE because the engine normalises
   user input to upper case before matching.

   Rules of thumb:

   * Punctuation in the user's input is stripped before matching - don't
     include "?" or "." in your patterns.
   * Use the wildcard star to capture variable text - see the example.
   * Chain to an existing answer with srai instead of duplicating text.
   * Randomise replies with the random and li tags.
   * You can also drop additional .aiml files into this directory - every
     *.aiml file in aiml/xmen/aiml/ is loaded at startup.

   Sets, maps, and substitutions are optional advanced features. Drop .txt
   files into the sibling folders (sets/, maps/, substitutions/) at
   aiml/xmen/. Empty folders are fine.

   Bot identity (name / language / version) lives in
   aiml/xmen/system/bot.properties.
-->
<aiml version="2.0">

    <!-- ===== Add your own category blocks below this line ===== -->



    <!-- Example category. Delete or replace once you have your own. -->
    <category>
        <pattern>TEACH ME SOMETHING NEW</pattern>
        <template>
            Edit TRAINING-PLACEHOLDER.aiml under aiml/xmen/aiml/ and add a
            new category block. The next time X-Men starts, I'll know
            whatever you taught me.
        </template>
    </category>

    <!-- ===== Add your own category blocks above this line ===== -->

</aiml>
