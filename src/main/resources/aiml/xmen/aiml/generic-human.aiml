<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <!--
      Generic conversational training for the offline X-Men assistant.
      Kept in a new file so the existing domain AIML data remains untouched.
      Uses AIML categories plus srai redirects, following the existing brain's
      convention of ending authored templates with [[FOLLOWUPS]] chips.
    -->

    <category>
        <pattern>WHAT CAN YOU HELP ME WITH</pattern>
        <template><![CDATA[I can help with the X-Men workflow, mutation choices, derivation-depth options, vocabulary profiles, and general questions about how to think through a protocol-analysis task.

If the question is outside the tool, I will keep the answer practical and say when I am unsure.
[[FOLLOWUPS]] What mutations are available? | Which mutation should I pick? | How does the analysis pipeline work?]]></template>
    </category>

    <category><pattern>HELP</pattern><template><srai>WHAT CAN YOU HELP ME WITH</srai></template></category>
    <category><pattern>HELP ME</pattern><template><srai>WHAT CAN YOU HELP ME WITH</srai></template></category>
    <category><pattern>WHAT CAN YOU DO</pattern><template><srai>WHAT CAN YOU HELP ME WITH</srai></template></category>
    <category><pattern>WHAT DO YOU DO</pattern><template><srai>WHAT CAN YOU HELP ME WITH</srai></template></category>
    <category><pattern>HOW CAN YOU HELP</pattern><template><srai>WHAT CAN YOU HELP ME WITH</srai></template></category>

    <category>
        <pattern>HOW ARE YOU</pattern>
        <template><![CDATA[I am doing well, thank you. I am here, loaded, and ready to help you reason through the protocol work without making the interface feel like a wall of buttons.

[[FOLLOWUPS]] What can you help me with? | Which mutation should I pick? | How does the analysis pipeline work?]]></template>
    </category>

    <category><pattern>HOW ARE YOU DOING</pattern><template><srai>HOW ARE YOU</srai></template></category>
    <category><pattern>ARE YOU OKAY</pattern><template><srai>HOW ARE YOU</srai></template></category>

    <category>
        <pattern>THANK YOU</pattern>
        <template><![CDATA[You are welcome. Send me the next question when you have it.

[[FOLLOWUPS]] What mutations are available? | What case studies do you support? | What can you help me with?]]></template>
    </category>

    <category><pattern>THANKS</pattern><template><srai>THANK YOU</srai></template></category>
    <category><pattern>THANKS A LOT</pattern><template><srai>THANK YOU</srai></template></category>
    <category><pattern>CHEERS</pattern><template><srai>THANK YOU</srai></template></category>

    <category>
        <pattern>WHAT IS AI</pattern>
        <template><![CDATA[AI is software built to perform tasks that usually need human-like judgment, such as understanding language, finding patterns, making suggestions, or planning a next step. In this app, the assistant is deliberately narrow: it uses local AIML training and a small keyword layer, not an internet-connected model.

[[FOLLOWUPS]] Are you AI? | What can you help me with? | How does X Men work?]]></template>
    </category>

    <category><pattern>EXPLAIN AI</pattern><template><srai>WHAT IS AI</srai></template></category>
    <category><pattern>WHAT IS ARTIFICIAL INTELLIGENCE</pattern><template><srai>WHAT IS AI</srai></template></category>

    <category>
        <pattern>WHAT IS A CHATBOT</pattern>
        <template><![CDATA[A chatbot is an interface that lets a person ask questions in natural language and receive conversational replies. This one is best at guided help for X-Men: explaining mutations, choosing options, and keeping useful follow-up suggestions close by.

[[FOLLOWUPS]] What can you help me with? | What mutations are available? | Which mutation should I pick?]]></template>
    </category>

    <category><pattern>EXPLAIN CHATBOT</pattern><template><srai>WHAT IS A CHATBOT</srai></template></category>
    <category><pattern>WHAT IS CHAT BOT</pattern><template><srai>WHAT IS A CHATBOT</srai></template></category>

    <category>
        <pattern>CAN YOU TALK LIKE A HUMAN</pattern>
        <template><![CDATA[I can keep the tone more natural: short, direct, and helpful. I will avoid pretending to know things I do not know, and I will offer good next questions when a topic is unclear.

[[FOLLOWUPS]] What can you help me with? | Which mutation should I pick? | How does the analysis pipeline work?]]></template>
    </category>

    <category><pattern>TALK LIKE A HUMAN</pattern><template><srai>CAN YOU TALK LIKE A HUMAN</srai></template></category>
    <category><pattern>BE MORE HUMAN</pattern><template><srai>CAN YOU TALK LIKE A HUMAN</srai></template></category>

    <category>
        <pattern>I AM CONFUSED</pattern>
        <template><![CDATA[That is fine. The easiest way through is to pick the closest goal:

- If you want to know what the tool does, ask about the pipeline.
- If you want to choose an operation, ask which mutation fits.
- If you want to understand a result, ask what the generated file is testing.

[[FOLLOWUPS]] How does the analysis pipeline work? | Which mutation should I pick? | What mutations are available?]]></template>
    </category>

    <category><pattern>I DO NOT UNDERSTAND</pattern><template><srai>I AM CONFUSED</srai></template></category>
    <category><pattern>THIS IS CONFUSING</pattern><template><srai>I AM CONFUSED</srai></template></category>
    <category><pattern>WHERE SHOULD I START</pattern><template><srai>I AM CONFUSED</srai></template></category>

    <category>
        <pattern>WHAT SHOULD I ASK</pattern>
        <template><![CDATA[Ask something concrete, even if it is rough. Good starting points are: what a mutation does, which mutation fits your scenario, why a derivation depth matters, or how to read the generated output.

[[FOLLOWUPS]] What mutations are available? | Which mutation should I pick? | What are derivation depth modes?]]></template>
    </category>

    <category><pattern>SUGGEST A QUESTION</pattern><template><srai>WHAT SHOULD I ASK</srai></template></category>
    <category><pattern>GIVE ME SUGGESTIONS</pattern><template><srai>WHAT SHOULD I ASK</srai></template></category>

</aiml>
